{
 "id": "13j-doi-404",
 "spec_item": 13,
 "tag": "spec",
 "title": "a DOI Crossref does not know is unresolved",
 "tool": "glean-resolve",
 "servers": {
  "A": {
   "/works/10.1000%2Fnope": {
    "status": 404,
    "body": "{\"message\": \"Resource not found.\"}",
    "headers": {
     "Content-Type": "application/json"
    }
   },
   "/works/10.1000/nope": {
    "status": 404,
    "body": "{\"message\": \"Resource not found.\"}",
    "headers": {
     "Content-Type": "application/json"
    }
   }
  }
 },
 "env": {
  "GLEAN_CROSSREF_API_BASE": "http://127.0.0.1:{{PORT_A}}"
 },
 "args": [
  "doi:10.1000/nope",
  "--now",
  "{{NOW}}"
 ],
 "expect": {
  "exit": [
   2
  ],
  "json": [
   {
    "path": "status",
    "equals": "unresolved"
   }
  ]
 }
}
