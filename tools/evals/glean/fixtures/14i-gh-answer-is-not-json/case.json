{
 "id": "14i-gh-answer-is-not-json",
 "spec_item": 14,
 "tag": "principle",
 "title": "gh answering with text that is not JSON is unresolved, not a crash",
 "tool": "glean-resolve",
 "servers": {},
 "env": {},
 "args": [
  "o/r",
  "--now",
  "{{NOW}}"
 ],
 "expect": {
  "exit": [
   2
  ],
  "json": [
   {
    "path": "status",
    "equals": "unresolved"
   }
  ]
 },
 "fake_gh": {
  "auth": true,
  "api": {
   "repos/o/r": "this is not an object"
  }
 }
}
