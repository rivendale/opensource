{
 "id": "13g2-crossref-title-escapes",
 "spec_item": 2,
 "tag": "spec",
 "title": "escape sequences in a Crossref title (JSON allows them) never reach stdout",
 "tool": "glean-resolve",
 "servers": {
  "A": {
   "/works/10.1000%2Fxyz123": {
    "status": 200,
    "body": "{\"status\": \"ok\", \"message\": {\"DOI\": \"10.1000/xyz123\", \"URL\": \"https://doi.org/10.1000/xyz123\", \"title\": [\"Nice \\u001b[31mTitle\\u001b[0m \\u0000 done\"], \"license\": []}}",
    "headers": {
     "Content-Type": "application/json"
    }
   },
   "/works/10.1000/xyz123": {
    "status": 200,
    "body": "{\"status\": \"ok\", \"message\": {\"DOI\": \"10.1000/xyz123\", \"URL\": \"https://doi.org/10.1000/xyz123\", \"title\": [\"Nice \\u001b[31mTitle\\u001b[0m \\u0000 done\"], \"license\": []}}",
    "headers": {
     "Content-Type": "application/json"
    }
   }
  }
 },
 "env": {
  "GLEAN_CROSSREF_API_BASE": "http://127.0.0.1:{{PORT_A}}"
 },
 "args": [
  "doi:10.1000/xyz123",
  "--now",
  "{{NOW}}"
 ],
 "expect": {
  "exit": [
   0
  ],
  "no_control_chars": true,
  "not_contains": [
   "\\[31m"
  ]
 }
}
