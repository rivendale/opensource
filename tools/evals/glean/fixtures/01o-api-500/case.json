{
 "id": "01o-api-500",
 "spec_item": 1,
 "tag": "principle",
 "title": "an API error is unresolved with a reason",
 "tool": "glean-resolve",
 "servers": {
  "A": {
   "/repos/o/r": {
    "status": 500,
    "body": "{\"message\": \"boom\"}",
    "headers": {
     "Content-Type": "application/json"
    }
   }
  }
 },
 "env": {
  "GLEAN_GH_API_BASE": "http://127.0.0.1:{{PORT_A}}"
 },
 "args": [
  "o/r",
  "--now",
  "{{NOW}}"
 ],
 "expect": {
  "exit": [
   2
  ],
  "json": [
   {
    "path": "status",
    "equals": "unresolved"
   },
   {
    "path": "error",
    "regex": "."
   }
  ]
 },
 "fake_gh": {
  "auth": true,
  "api": {}
 }
}
