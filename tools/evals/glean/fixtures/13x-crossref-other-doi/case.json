{
 "id": "13x-crossref-other-doi",
 "spec_item": 13,
 "tag": "spec",
 "title": "a Crossref answer for a different DOI is refused",
 "tool": "glean-resolve",
 "servers": {
  "A": {
   "/works/10.1000%2Fxyz123": {
    "status": 200,
    "body": "{\"status\": \"ok\", \"message\": {\"DOI\": \"10.9999/other\", \"URL\": \"https://doi.org/10.9999/other\", \"title\": [\"A Crossref Paper\"], \"license\": []}}",
    "headers": {
     "Content-Type": "application/json"
    }
   },
   "/works/10.1000/xyz123": {
    "status": 200,
    "body": "{\"status\": \"ok\", \"message\": {\"DOI\": \"10.9999/other\", \"URL\": \"https://doi.org/10.9999/other\", \"title\": [\"A Crossref Paper\"], \"license\": []}}",
    "headers": {
     "Content-Type": "application/json"
    }
   }
  }
 },
 "env": {
  "GLEAN_CROSSREF_API_BASE": "http://127.0.0.1:{{PORT_A}}"
 },
 "args": [
  "doi:10.1000/xyz123",
  "--now",
  "{{NOW}}"
 ],
 "expect": {
  "exit": [
   2
  ],
  "json": [
   {
    "path": "status",
    "equals": "unresolved"
   }
  ]
 }
}
