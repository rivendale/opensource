{
 "id": "13e-paper-not-found",
 "spec_item": 13,
 "tag": "spec",
 "title": "an arXiv answer with no entry is unresolved",
 "tool": "glean-resolve",
 "servers": {
  "A": {
   "/query": {
    "headers": {
     "Content-Type": "application/atom+xml"
    },
    "body": "<?xml version='1.0'?><feed xmlns='http://www.w3.org/2005/Atom'></feed>"
   }
  }
 },
 "env": {
  "GLEAN_ARXIV_API_BASE": "http://127.0.0.1:{{PORT_A}}"
 },
 "args": [
  "arxiv:2301.99999v1",
  "--now",
  "{{NOW}}"
 ],
 "expect": {
  "exit": [
   2
  ],
  "json": [
   {
    "path": "status",
    "equals": "unresolved"
   }
  ]
 }
}
