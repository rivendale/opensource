{
 "id": "14b-gh-unauthenticated",
 "spec_item": 14,
 "tag": "spec",
 "title": "gh present but not logged in: 'CANNOT READ (gh)', exit 2",
 "tool": "glean-resolve",
 "servers": {},
 "env": {},
 "args": [
  "o/r",
  "--now",
  "{{NOW}}"
 ],
