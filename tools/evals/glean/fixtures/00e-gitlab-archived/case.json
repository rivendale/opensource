{
 "id": "00e-gitlab-archived",
 "spec_item": 12,
 "tag": "spec",
 "title": "an archived GitLab project is flagged ARCHIVED",
 "tool": "glean-resolve",
 "servers": {
  "A": {
   "/projects/o%2Fr": {
    "status": 200,
    "body": "{\"web_url\": \"https://gitlab.com/o/r\", \"path_with_namespace\": \"o/r\", \"id\": 42, \"default_branch\": \"main\", \"star_count\": 5, \"last_activity_at\": \"2026-09-30T10:00:00Z\", \"archived\": true}",
    "headers": {
     "Content-Type": "application/json"
    }
   },
   "/projects/o%2Fr/repository/commits/main": {
    "status": 200,
    "body": "{\"id\": \"a1b2c3d4e5f60718293a4b5c6d7e8f9012345678\"}",
    "headers": {
     "Content-Type": "application/json"
    }
   }
  }
 },
 "env": {
  "GLEAN_GITLAB_API_BASE": "http://127.0.0.1:{{PORT_A}}"
 },
 "args": [
  "https://gitlab.com/o/r",
  "--now",
  "{{NOW}}"
 ],
 "expect": {
  "exit": [
   0
  ],
  "json": [
   {
    "path": "health.archived",
    "equals": true
   }
  ],
  "finding_includes": [
   "ARCHIVED"
  ]
 }
}
