{
 "id": "01q-huge-answer",
 "spec_item": 1,
 "tag": "principle",
 "title": "an answer over 1 MiB is refused, in bounded time",
 "tool": "glean-resolve",
 "servers": {
  "A": {
   "/repos/o/r": {
    "body_repeat": {
     "char": "x",
     "count": 1500000
    },
    "headers": {
     "Content-Type": "application/json"
    }
   }
  }
 },
 "env": {
  "GLEAN_GH_API_BASE": "http://127.0.0.1:{{PORT_A}}"
 },
 "args": [
  "o/r",
  "--now",
  "{{NOW}}"
 ],
 "expect": {
  "exit": [
   2
  ],
  "json": [
   {
    "path": "status",
    "equals": "unresolved"
   }
  ],
  "max_seconds": 30
 },
 "fake_gh": {
  "auth": true,
  "api": {}
 },
 "timeout": 60
}
