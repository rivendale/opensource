{
 "id": "13za-arxiv-utf16-bom-le-entity",
 "spec_item": 13,
 "tag": "principle",
 "title": "a UTF-16 (little-endian, BOM) feed that declares an entity is refused, not expanded",
 "tool": "glean-resolve",
 "servers": {
  "A": {
   "/query": {
    "headers": {
     "Content-Type": "application/atom+xml"
    },
    "body": {
     "hex": ""
    }
   }
  }
 },
 "env": {
  "GLEAN_ARXIV_API_BASE": "http://127.0.0.1:{{PORT_A}}"
 },
 "args": [
  "arxiv:2301.00001v2",
  "--now",
  "{{NOW}}"
 ],
 "expect": {
  "exit": [
   2
  ],
  "json": [
   {
    "path": "status",
    "equals": "unresolved"
   }
  ],
  "not_contains": [
   "EXPANDED-TITLE-MARKER"
  ],
  "stderr_not_contains": [
   "Traceback"
  ]
 }
}
