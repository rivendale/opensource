{
 "id": "01m-repo-404",
 "spec_item": 1,
 "tag": "spec",
 "title": "a repo the API says is 404 is unresolved (with the reason), exit 2",
 "tool": "glean-resolve",
 "servers": {
  "A": {
   "/repos/o/gone": {
    "status": 404,
    "body": "{\"message\": \"Not Found\"}",
    "headers": {
     "Content-Type": "application/json"
    }
   }
  }
 },
 "env": {
  "GLEAN_GH_API_BASE": "http://127.0.0.1:{{PORT_A}}"
 },
 "args": [
  "o/gone",
  "--now",
  "{{NOW}}"
 ],
 "expect": {
  "exit": [
   2
  ],
  "json": [
   {
    "path": "status",
    "equals": "unresolved"
   },
   {
    "path": "error",
    "regex": "(?i)unresolved|not found|404"
   }
  ]
 },
 "fake_gh": {
  "auth": true,
  "api": {}
 }
}
