{
 "id": "14h-gh-answer-too-big",
 "spec_item": 14,
 "tag": "spec",
 "title": "a gh answer over 1 MiB is refused (CANNOT READ), never parsed",
 "tool": "glean-resolve",
 "servers": {},
 "env": {},
 "args": [
  "o/r",
  "--now",
  "{{NOW}}"
 ],
