{
 "id": "13zd-arxiv-declared-latin1-is-refused",
 "spec_item": 13,
 "tag": "principle",
 "title": "a feed that declares a non-UTF-8 encoding is refused even when it carries no DOCTYPE (the arXiv feed is UTF-8)",
 "tool": "glean-resolve",
 "servers": {
  "A": {
   "/query": {
    "headers": {
     "Content-Type": "application/atom+xml"
    },
    "body": {
     "hex": ""
    }
   }
  }
 },
 "env": {
  "GLEAN_ARXIV_API_BASE": "http://127.0.0.1:{{PORT_A}}"
 },
 "args": [
  "arxiv:2301.00001v2",
  "--now",
  "{{NOW}}"
 ],
 "expect": {
  "exit": [
   2
  ],
  "json": [
   {
    "path": "status",
    "equals": "unresolved"
   }
  ],
  "stderr_not_contains": [
   "Traceback"
  ]
 }
}
