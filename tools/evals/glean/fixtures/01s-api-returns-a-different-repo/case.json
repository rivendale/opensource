{
 "id": "01s-api-returns-a-different-repo",
 "spec_item": 10,
 "tag": "spec",
 "title": "an API answer whose full_name is not the repo asked for is refused: no substitute",
 "tool": "glean-resolve",
 "servers": {
  "A": {
   "/repos/o/r": {
    "status": 200,
    "body": "{\"full_name\": \"someone/else\", \"html_url\": \"https://github.com/someone/else\", \"default_branch\": \"main\", \"stargazers_count\": 1, \"pushed_at\": \"2026-09-30T10:00:00Z\", \"archived\": false, \"license\": {\"spdx_id\": \"MIT\"}}",
    "headers": {
     "Content-Type": "application/json"
    }
   },
   "/repos/o/r/commits/main": {
    "status": 200,
    "body": "{\"sha\": \"a1b2c3d4e5f60718293a4b5c6d7e8f9012345678\"}",
    "headers": {
     "Content-Type": "application/json"
    }
   },
   "/repos/o/r/commits/a1b2c3d4e5f60718293a4b5c6d7e8f9012345678": {
    "status": 200,
    "body": "{\"sha\": \"a1b2c3d4e5f60718293a4b5c6d7e8f9012345678\"}",
    "headers": {
     "Content-Type": "application/json"
    }
   },
   "/repos/o/r/commits/a1b2c3d": {
    "status": 200,
    "body": "{\"sha\": \"a1b2c3d4e5f60718293a4b5c6d7e8f9012345678\"}",
    "headers": {
     "Content-Type": "application/json"
    }
   },
   "/repos/o/r/security-advisories": {
    "status": 200,
    "body": "[]",
    "headers": {
