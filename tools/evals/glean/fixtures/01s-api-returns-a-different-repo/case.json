   },
   "/repos/o/r/license": {
    "status": 200,
    "body": "{\"name\": \"LICENSE\", \"path\": \"LICENSE\", \"sha\": \"bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb\", \"size\": 1070, \"type\": \"file\", \"encoding\": \"base64\", \"content\": \"TGljZW5zZSB0ZXh0Cg==\", \"url\": \"https://api.github.com/repos/o/r/contents/LICENSE?ref=a1b2c3d4e5f60718293a4b5c6d7e8f9012345678\", \"html_url\": \"https://github.com/o/r/blob/a1b2c3d4e5f60718293a4b5c6d7e8f9012345678/LICENSE\", \"git_url\": \"https://api.github.com/repos/o/r/git/blobs/bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb\", \"download_url\": \"https://raw.githubusercontent.com/o/r/a1b2c3d4e5f60718293a4b5c6d7e8f9012345678/LICENSE\", \"license\": {\"key\": \"mit\", \"name\": \"MIT\", \"spdx_id\": \"MIT\", \"url\": null, \"node_id\": \"x\"}}",
    "headers": {
     "Content-Type": "application/json"
    }
   }
  }
 },
 "env": {
  "GLEAN_GH_API_BASE": "http://127.0.0.1:{{PORT_A}}"
 },
 "args": [
  "o/r",
  "--now",
  "{{NOW}}"
 ],
 "expect": {
  "exit": [
