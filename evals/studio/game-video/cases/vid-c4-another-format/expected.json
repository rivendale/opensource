{
  "case": "vid-c4-another-format",
  "skill": "game-video",
  "purpose": "the format rules follow the brief's numbers, not 640x360 / 30 fps / 12 s",
  "item": "control",
  "kind": "M",
  "tools": [
    "python3",
    "ffmpeg 7.0.2 (libx264, aac)",
    "numpy"
  ],
  "rules": [
    {
      "id": "format",
      "type": "video_format",
      "file": "assets/video/trailer.mp4",
      "width": 1280,
      "height": 720,
      "fps": 25,
      "duration": 10.0,
      "duration_tol": 0.5
    },
    {
      "id": "loudness",
      "type": "video_loudness",
      "file": "assets/video/trailer.mp4",
      "target": -14.0,
      "tol": 1.0,
      "max_dbtp": -1.0
    },
    {
      "id": "manifest_valid",
      "type": "manifest_valid",
      "import_paths": [
        "assets"
      ]
    },
    {
      "id": "manifest_rows",
      "type": "manifest_rows",
      "files": [
        "assets/video/trailer.mp4",
        "assets/audio/narration.wav"
      ]
    }
  ]
}
