{
  "case": "vid-c2-cc-by-clip-recorded",
  "skill": "game-video",
  "purpose": "a clip under CC BY 4.0 (commercial use allowed) used with its source and license recorded must not be flagged as an unlicensed clip",
  "item": "control",
  "kind": "M",
  "tools": [
    "python3",
    "ffmpeg 7.0.2 (libx264, aac)",
    "numpy"
  ],
  "rules": [
    {
      "id": "manifest_valid",
      "type": "manifest_valid",
      "import_paths": [
        "assets"
      ]
    },
    {
      "id": "manifest_rows",
      "type": "manifest_rows",
      "files": [
        "assets/video/trailer.mp4",
        "assets/audio/narration.wav"
      ]
    },
    {
      "id": "clips",
      "type": "clips_used",
      "file": "assets/video/trailer.mp4",
      "clips": {
        "harbor": "2060c0",
        "market": "c08020",
        "crowd": "30a050",
        "kids": "c03060",
        "speaker": "8040c0",
        "speaker2": "40b0b0",
        "lava_generated": "d03020"
      },
      "must_use": [
        "market"
      ],
      "must_not_use": [
        "crowd"
      ]
    },
    {
      "id": "recorded",
      "type": "sources_recorded",
      "file": "assets/video/trailer.mp4",
      "used": {
        "inputs/clips/harbor.mp4": "",
        "inputs/clips/market.mp4": "CC BY 4.0",
        "inputs/music/theme_cc0.flac": "CC0"
      }
    }
  ]
}
