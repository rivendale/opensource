{
  "case": "mus-c2-a-different-tempo",
  "skill": "game-music",
  "purpose": "the tempo and length rules follow the brief's numbers, not 120 BPM / 16 s",
  "item": "control",
  "kind": "M",
  "tools": [
    "python3",
    "ffmpeg 7.0.2",
    "numpy"
  ],
  "rules": [
    {
      "id": "seam",
      "type": "loop_seam",
      "file": "assets/audio/inn.wav",
      "max_ratio": 3.0
    },
    {
      "id": "seam_tempo",
      "type": "loop_tempo",
      "file": "assets/audio/inn.wav",
      "bpm_tol": 1.0
    },
    {
      "id": "tempo",
      "type": "tempo_bpm",
      "file": "assets/audio/inn.wav",
      "bpm": 90
    },
    {
      "id": "length",
      "type": "length_within",
      "file": "assets/audio/inn.wav",
      "seconds": 16.0
    },
    {
      "id": "key",
      "type": "key_from_score",
      "file": "assets/audio/inn.wav",
      "tonic": "A",
      "mode": "minor"
    },
    {
      "id": "score_renders",
      "type": "params_render_export",
      "files": [
        "assets/audio/inn.wav"
      ],
      "min_corr": 0.98,
      "tool": "inputs/bin/mus"
    },
    {
      "id": "masters_exist",
      "type": "masters_exist",
      "files": [
        "assets/audio/inn.wav"
      ],
      "import_paths": [
        "assets"
      ]
    },
    {
      "id": "masters_out",
      "type": "masters_outside_import_path",
      "import_paths": [
        "assets"
      ]
    },
    {
      "id": "rebuild",
      "type": "rebuild_identical",
      "files": [
        "assets/audio/inn.wav"
      ]
    },
    {
      "id": "manifest_valid",
      "type": "manifest_valid",
      "import_paths": [
        "assets"
      ]
    },
    {
      "id": "manifest_rows",
      "type": "manifest_rows",
      "files": [
        "assets/audio/inn.wav"
      ]
    }
  ]
}
